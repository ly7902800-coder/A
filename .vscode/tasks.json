{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Get Dependencies",
      "type": "shell",
      "command": "./tool/cloud_ide.sh get",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Preview Web",
      "type": "shell",
      "command": "./tool/cloud_ide.sh preview",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flutter: Run Web",
      "type": "shell",
      "command": "./tool/cloud_ide.sh run",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flutter: DevTools",
      "type": "shell",
      "command": "./tool/cloud_ide.sh devtools",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flutter: Pub Add",
      "type": "shell",
      "command": "PACKAGE=${input:package} ./tool/cloud_ide.sh pub-add",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Analyze",
      "type": "shell",
      "command": "./tool/cloud_ide.sh analyze",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Test",
      "type": "shell",
      "command": "./tool/cloud_ide.sh test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Clean",
      "type": "shell",
      "command": "./tool/cloud_ide.sh clean",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Doctor",
      "type": "shell",
      "command": "./tool/cloud_ide.sh doctor",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Code Generation",
      "type": "shell",
      "command": "cd apps/mobile && dart run build_runner build --delete-conflicting-outputs",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Watch Code Generation",
      "type": "shell",
      "command": "cd apps/mobile && dart run build_runner watch --delete-conflicting-outputs",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Build APK",
      "type": "shell",
      "command": "./tool/cloud_ide.sh apk",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Build AAB",
      "type": "shell",
      "command": "./tool/cloud_ide.sh aab",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "package",
      "type": "promptString",
      "description": "pub.dev package name"
    }
  ]
}
